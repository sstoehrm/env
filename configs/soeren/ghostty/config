# ~/.config/ghostty/config
# Companion to configs/soeren/tmux/tmux.conf — by design ghostty delegates
# multiplexing (tabs/splits/sessions) to tmux. The leader chord bindings
# below are commented out so tmux owns ctrl+p; uncomment them to use
# ghostty's own splits/tabs instead (e.g. when running ghostty without tmux).

# --- Bell ---
bell = none

# --- Appearance ---
font-size = 12

# Carbonfox color scheme
background = #161616
foreground = #f2f4f8
selection-background = #2a2a2a
selection-foreground = #f2f4f8
cursor-color = #f2f4f8
cursor-text = #161616

palette = 0=#282828
palette = 1=#ee5396
palette = 2=#25be6a
palette = 3=#08bdba
palette = 4=#78a9ff
palette = 5=#be95ff
palette = 6=#33b1ff
palette = 7=#dfdfe0
palette = 8=#484848
palette = 9=#f16da6
palette = 10=#46c880
palette = 11=#2dc7c4
palette = 12=#8cb6ff
palette = 13=#c8a5ff
palette = 14=#52bdff
palette = 15=#e4e4e5

# Initial window size (matches wezterm.lua: 120 cols × 28 rows)
window-width = 120
window-height = 28

# --- Pane navigation (disabled for tmux pairing) ---
# Ghostty captures alt+hjkl/arrows BEFORE tmux sees them, which blocks tmux's
# own pane navigation. Uncomment these only when running ghostty standalone.
# keybind = alt+h=goto_split:left
# keybind = alt+j=goto_split:down
# keybind = alt+k=goto_split:up
# keybind = alt+l=goto_split:right
# keybind = alt+left=goto_split:left
# keybind = alt+down=goto_split:down
# keybind = alt+up=goto_split:up
# keybind = alt+right=goto_split:right

# === Ghostty-native leader bindings (disabled by default for tmux pairing) ===
# If you uncomment these, tmux will not receive ctrl+p — pick one.
#
# Splits (wezterm SplitVertical=top/bottom -> new_split:down; SplitHorizontal=left/right -> new_split:right)
# keybind = ctrl+p>h=new_split:down
# keybind = ctrl+p>v=new_split:right
#
# Pane zoom and close
# keybind = ctrl+p>f=toggle_split_zoom
# keybind = ctrl+p>q=close_surface
#
# Tab management
# keybind = ctrl+p>shift+c=new_tab
# keybind = ctrl+p>shift+q=close_tab
# keybind = ctrl+p>shift+h=previous_tab
# keybind = ctrl+p>shift+l=next_tab
# keybind = ctrl+p>shift+left=previous_tab
# keybind = ctrl+p>shift+right=next_tab
#
# Activate tab N
# keybind = ctrl+p>1=goto_tab:1
# keybind = ctrl+p>2=goto_tab:2
# keybind = ctrl+p>3=goto_tab:3
# keybind = ctrl+p>4=goto_tab:4
# keybind = ctrl+p>5=goto_tab:5
# keybind = ctrl+p>6=goto_tab:6
# keybind = ctrl+p>7=goto_tab:7
# keybind = ctrl+p>8=goto_tab:8
# keybind = ctrl+p>9=goto_tab:9
#
# Resize mode (modal key table — ghostty's analog of wezterm key_tables)
# keybind = ctrl+p>r=activate_key_table:resize_mode
# keybind = resize_mode/h=resize_split:left,2
# keybind = resize_mode/j=resize_split:down,2
# keybind = resize_mode/k=resize_split:up,2
# keybind = resize_mode/l=resize_split:right,2
# keybind = resize_mode/escape=deactivate_key_table
# keybind = resize_mode/catch_all=ignore

# Things ghostty does NOT support (handled by tmux instead):
#   - Startup multi-tab/split layout      (use configs/soeren/tmux/startup.sh)
#   - Session save/restore (resurrect)    (use tmux-resurrect + tmux-continuum)
#   - Set-tab-title prompt                (no prompt action in ghostty)
